{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BCChatbot",
      "request": "launch",
      "type": "al",
      "environmentType": "OnPrem",
      "server": "http://BCChatbot", // Originalno: "http://bc27dev" (stari container koji više nije u upotrebi)
      "serverInstance": "BC",
      "authentication": "UserPassword",
      "startupObjectId": 22,
      "startupObjectType": "Page",
      "breakOnError": "ExcludeTry",
      "breakOnRecordWrite": "None",
      "launchBrowser": true,
      "enableLongRunningSqlStatements": true,
      "enableSqlInformationDebugger": true
    }
  ]
}
