{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "BCChatbot",
      "request": "launch",
      "type": "al",
      "environmentType": "OnPrem",
      "server": "http://172.29.7.111", // BCChatbot hosts alias trenutno pokazuje na stari subnet (172.23.*)
      "serverInstance": "BC",
      "authentication": "UserPassword",
      "usePublicURLFromServer": false,
      "startupObjectId": 22,
      "startupObjectType": "Page",
      "breakOnError": "ExcludeTry",
      "breakOnRecordWrite": "None",
      "launchBrowser": true,
      "enableLongRunningSqlStatements": true,
      "enableSqlInformationDebugger": true
    }
  ]
}
